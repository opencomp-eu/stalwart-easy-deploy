# stalwart-easy-deploy — operator configuration
# Copy to deploy.yaml and run: bash apply.sh

stalwart:
  # Public hostname (MX target, admin UI, JMAP / OAuth discovery)
  hostname: mail.example.com
  # Primary email domain served by this installation
  domain: example.com
  image: docker.io/stalwartlabs/stalwart
  tag: "v0.16.20"
  data_dir: /var/lib/stalwart
  # Caddy terminates HTTPS and proxies plain HTTP to Stalwart :8080.
  # Only set https if you have a working TLS listener on stalwart:443.
  # caddy_upstream: http

bulwark:
  enabled: true
  domain: webmail.example.com
  image: ghcr.io/bulwarkmail/webmail
  tag: "1.9.2"
  data_dir: /var/lib/bulwark
  app_name: Webmail

# Host bindings for mail protocols (Caddy does not proxy these)
ports:
  smtp: 25
  submission: 587
  submissions: 465
  imaps: 993
  sieve: 4190

# identity.provider: kanidm — written by easydeploy-engine.
# Bulwark signs in through Kanidm OIDC. IMAP/SMTP use a Stalwart app password.
# Set identity.auth_directory: ldap to bind IMAP with the Kanidm password instead.
# Set identity.managed: false to keep Stalwart's internal directory.
# identity:
#   provider: kanidm

proxy:
  type: caddy
  # standalone — this kit runs its own Caddy on :443 (single-service VPS)
  # integrate — join easydeploy-net; easydeploy-engine owns Caddy (multi-service VPS)
  mode: standalone
  integrate:
    network: easydeploy-net

# Optional Borg backup repository and automatic schedule.
# Backups include this file, generated state, and configured data directories.
backup:
  enabled: false
  repository:
    type: local
    path: /var/backups/stalwart
    # For SFTP repositories, set type, host, user, path, and ssh_key_path.
    # host: backup.example.com
    # user: borg
    # port: 22
    # ssh_key_path: /root/.ssh/borg_backup
    # host_key_check: true
    encryption: repokey
  schedule:
    enabled: false
    calendar: "*-*-* 03:00:00"
    persistent: true
  retention:
    keep_daily: 7
    keep_weekly: 4
    keep_monthly: 6
    keep_yearly: 0
